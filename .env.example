# Copy this file to .env and fill in real values for local development.
# In production these are injected by Dokploy - never commit real values.

# ---- Django ----
SECRET_KEY=generate-a-long-random-secret-here
ENV=DEV
# DEV = SQLite + permissive CORS/localhost hosts (see t_and_p_automation/settings.py).
# PROD (or unset) = MySQL + Gunicorn + the hardened settings below; every
# variable in this section becomes required once ENV != DEV.
DJANGO_ALLOWED_HOSTS=api.yourproject.example.com
CURRENT_HOST=127.0.0.1
# Whether Django issues its own HTTP->HTTPS redirect. Set false when the edge
# terminates TLS and forwards plain HTTP to the origin (Cloudflare "Flexible"),
# otherwise Django 301s every request into a redirect loop. Set true (or leave
# unset) when the origin genuinely receives HTTPS (Cloudflare "Full"/"Full
# (strict)"). Defaults: false in DEV, true in PROD.
SECURE_SSL_REDIRECT=true

# ---- Database (managed MySQL, provisioned by TCET IT - do not run your own
# MySQL container; see docker-compose.yml) ----
DATABASE_HOST=mysql-host-provided-by-it
DATABASE_PORT=3306
DATABASE_NAME=t_and_p_automation
DATABASE_USER=t_and_p
DATABASE_PASSWORD=your_db_password

# ---- Redis / Celery (self-hosted - this platform does not manage Redis for
# you, see docker-compose.yml's redis service) ----
REDIS_PASSWORD=change_me_strong_random_value

# ---- Email (OTP / notifications via Gmail SMTP) ----
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# ---- Frontend origin (used for CORS/CSRF and in email links) ----
# Must be the exact scheme+host the frontend is served from in production,
# e.g. https://yourproject.example.com (no trailing slash).
CLIENT_URL=http://localhost:5173
# Shares session/CSRF cookies between the frontend and api subdomains, e.g.
# ".yourproject.example.com" (leading dot). Leave unset in DEV.
COOKIE_DOMAIN=

# ---- Frontend build-time (Vite inlines these at `npm run build`, so they
# only take effect via docker-compose.yml's frontend build args - not at
# container runtime) ----
# The API's origin, e.g. https://api.yourproject.example.com. Leave empty
# for local dev (Vite's dev-server proxies same-origin requests instead).
VITE_SERVER_URL=

# ---- One-off bootstrap / seed scripts ----
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123
# Default password applied to every bulk-created/imported account (coordinators,
# faculty, students) that doesn't specify its own - policy is that everyone
# gets the same default and is expected to change it after first login.
DEFAULT_SEED_PASSWORD=tcet@1234
DEFAULT_FACULTY_IMPORT_PASSWORD=tcet@1234
DEFAULT_STUDENT_IMPORT_PASSWORD=tcet@1234
